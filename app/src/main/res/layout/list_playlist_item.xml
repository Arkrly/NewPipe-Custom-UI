<?xml version="1.0" encoding="utf-8"?>
<!-- Playlist List Item - Slim Style -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Thumbnail -->
        <FrameLayout
            android:id="@+id/itemThumbnailContainer"
            android:layout_width="140dp"
            android:layout_height="80dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/itemThumbnailView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/placeholder_background"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.NewPipe.Thumbnail"
                tools:src="@drawable/placeholder_thumbnail_video" />

            <!-- Stream count overlay -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="#CC0d1117"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_playlist_play"
                    app:tint="#c9d1d9"
                    tools:ignore="ContentDescription" />

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/itemStreamCountView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#c9d1d9"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="50" />

            </LinearLayout>

        </FrameLayout>

        <!-- Playlist Title -->
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/itemTitleView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#c9d1d9"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/itemThumbnailContainer"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Playlist Title" />

        <!-- Uploader -->
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/itemUploaderView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8b949e"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/itemTitleView"
            app:layout_constraintTop_toBottomOf="@id/itemTitleView"
            tools:text="Channel Name" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
