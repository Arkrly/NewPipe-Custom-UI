<?xml version="1.0" encoding="utf-8"?>
<!-- Player Controls Background - Glassmorphism Gradient
     Dark slate gradient from bottom for player controls overlay -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient from deep slate to transparent -->
    <gradient
        android:angle="90"
        android:startColor="#E60d1117"
        android:centerColor="#990d1117"
        android:endColor="#000d1117"
        android:type="linear" />

</shape>
