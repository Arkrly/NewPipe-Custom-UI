<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Input Field Background
     Deep dark input with neon blue accent border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Very dark input background -->
    <solid android:color="@color/input_background" />

    <!-- Fully rounded corners for pill-shaped inputs -->
    <corners android:radius="@dimen/radius_xl" />

    <!-- Neon blue border for focus indication -->
    <stroke
        android:width="@dimen/glass_border_width"
        android:color="@color/border_color" />

    <!-- Inner padding -->
    <padding
        android:left="@dimen/spacing_md"
        android:top="@dimen/spacing_sm"
        android:right="@dimen/spacing_md"
        android:bottom="@dimen/spacing_sm" />

</shape>
