<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism Panel Background
     Semi-transparent surface with subtle white border for depth -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Glass background: 80% opacity surface color -->
    <solid android:color="@color/glass_background" />

    <!-- Modern rounded corners -->
    <corners android:radius="@dimen/radius_lg" />

    <!-- Subtle white stroke for glass effect -->
    <stroke
        android:width="@dimen/glass_border_width"
        android:color="@color/glass_border" />

</shape>
